# Copy this file to ".env" and fill in the values (no quotes, no spaces)

# --- required ---
DISCORD_TOKEN=paste-bot-token-here
GUILD_ID=0
MOD_ROLE_ID=0
ADMIN_ROLE_ID=0

# --- dashboard (the manager page) ---
# Leave empty to switch the dashboard API off. Otherwise use a long random key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=
# Where the API listens. Keep 127.0.0.1 and expose it through a tunnel/reverse proxy (see README).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Address(es) of the website that hosts the dashboard page, comma separated. Empty = any site.
# Example: DASHBOARD_ORIGINS=https://www.yoursite.com
DASHBOARD_ORIGINS=

# Behind a web server/proxy: which header carries the visitor's real address (used for rate limits and spam pauses).
# nginx (see INSTALL-WEBSITE.md) = X-Real-IP, Cloudflare Tunnel = CF-Connecting-IP
CLIENT_IP_HEADER=X-Real-IP

# --- optional: starting values for the channels ---
# You normally pick these on the dashboard. Leave them out if you do.
REPORT_CHANNEL_ID=
MOD_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=
ADMIN_CHANNEL_ID=
# Welcome message channel (optional; can also be set on the dashboard)
WELCOME_CHANNEL_ID=
# Patch notes channel (optional; can also be set on the dashboard)
PATCHNOTES_CHANNEL_ID=
# Backup channel (optional; a daily copy of the database is posted here – make it ADMIN-ONLY)
BACKUP_CHANNEL_ID=
# Folder for kept screenshots and backups (default: ./data next to the bot)
DATA_DIR=data
